                    {
                        "description": "User credentials",
                        "name": "credentials",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/models.LoginRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "JWT Token",
                        "schema": {
                            "$ref": "#/definitions/models.LoginResponse"
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "$ref": "#/definitions/models.HTTPError"
                        }
                    }
                }
            }
        },
        "/data/climate_communications": {
            "post": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Returns a map of active communications grouped by date and indicator, filtered by building references.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Climate communications"
                ],
                "summary": "Get active climate communications",
                "parameters": [
                    {
                        "description": "List of building references to filter by",
                        "name": "references",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/models.ReferenceRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Grouped communications",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "object",
                                "additionalProperties": {
                                    "type": "array",
                                    "items": {
                                        "$ref": "#/definitions/models.CommunicationGroup"
                                    }
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Invalid input",
                        "schema": {
                            "$ref": "#/definitions/models.Message"
                        }
                    },
                    "405": {
                        "description": "Invalid method",
                        "schema": {
                            "$ref": "#/definitions/models.Message"
                        }
                    },
                    "500": {
                        "description": "Internal server error",
                        "schema": {
                            "$ref": "#/definitions/models.Message"
                        }
                    }
                }
            }
        },
        "/data/climate_shelters": {
            "post": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Returns the minimum walking time (in minutes) from each building to the nearest filtered climate shelter, as well as metadata including which shelter is closest and how many buildings are beyond a 10 and 20 minute threshold.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Climate shelters"
                ],
                "summary": "Get accessibility to climate shelters",
                "parameters": [
                    {
                        "description": "Filter parameters for shelter selection",
                        "name": "payload",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/data.RequestPayload"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/data.ResponsePayload"
                        }
                    },
                    "400": {
                        "description": "Invalid request payload",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "500": {
                        "description": "Internal server error",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/data/climate_shelters_details/{climate_shelter_id}": {
            "post": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Returns detailed information about a specific climate shelter identified by ID",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Climate shelters"
                ],
                "summary": "Get details of a specific climate shelter",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Climate Shelter ID",
                        "name": "climate_shelter_id",
                        "in": "path",
                        "required": true
                    },
                    {
                        "description": "Request payload with date and filters",
                        "name": "payload",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/data.RequestPayload"
                        }
                    }
                ],
                "responses": {}
            }
        },
        "/data/collection/aggregation_levels/{lang}": {
            "get": {
                "security": [
                    {
                        "BearerAuth": []
                    }
