                "description": "Returns a map of translated indicator names to their keys",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Indicators"
                ],
                "summary": "Get indicators",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Language (e.g. 'en', 'es', 'ca')",
                        "name": "lang",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "object",
