                "summary": "Get available aggregation levels with translation",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Language code (e.g., 'en', 'es', 'ca')",
                        "name": "lang",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    },
                    "405": {
                        "description": "Invalid request method",
                        "schema": {
                            "$ref": "#/definitions/models.HTTPError"
                        }
                    },
                    "500": {
                        "description": "Database query or decoding error",
                        "schema": {
                            "$ref": "#/definitions/models.HTTPError"
                        }
                    }
                }
            }
        },
        "/data/collection/indicators/{lang}": {
            "get": {
                "security": [
                    {
                        "BearerAuth": []
                    }
