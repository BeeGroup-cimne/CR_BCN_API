                                "type": "string"
                            }
                        }
                    },
                    "500": {
                        "description": "Database query or decoding error",
                        "schema": {
                            "$ref": "#/definitions/models.HTTPError"
                        }
                    }
                }
            }
        },
        "/data/collection/indicators_by_group/{aggregation_level}/{lang}": {
            "get": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Returns a list of KPIs grouped by their category, translated into the specified language.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Indicators"
                ],
                "summary": "Get grouped indicators",
                "parameters": [
                    {
                        "enum": [
                            "building",
                            "census_tract"
                        ],
                        "type": "string",
                        "description": "Aggregation level",
                        "name": "aggregation_level",
                        "in": "path",
                        "required": true
                    },
                    {
                        "enum": [
                            "en",
                            "es",
                            "ca"
                        ],
                        "type": "string",
                        "description": "Language code",
                        "name": "lang",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Group name as key and map of KPI name to KPI key as value",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "object",
                                "additionalProperties": {
                                    "type": "string"
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Invalid aggregation level",
                        "schema": {
                            "$ref": "#/definitions/models.HTTPError"
                        }
                    },
                    "500": {
                        "description": "Database query or decoding error",
                        "schema": {
                            "$ref": "#/definitions/models.HTTPError"
                        }
                    }
                }
            }
        },
        "/data/collection/indicators_by_reference/{aggregation_level}/{reference}": {
            "get": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Retrieves all KPI values for a specific reference and aggregation level.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Indicators"
                ],
                "summary": "Get indicators by reference",
                "parameters": [
                    {
                        "enum": [
                            "building",
                            "census_tract"
                        ],
                        "type": "string",
                        "description": "Aggregation level",
                        "name": "aggregation_level",
                        "in": "path",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "Reference ID",
                        "name": "reference",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Indicator values for the reference",
                        "schema": {
                            "$ref": "#/definitions/models.Indicator"
                        }
                    },
                    "400": {
                        "description": "Missing or invalid parameters",
                        "schema": {
                            "$ref": "#/definitions/models.HTTPError"
                        }
                    },
                    "404": {
                        "description": "Reference not found",
                        "schema": {
                            "$ref": "#/definitions/models.HTTPError"
                        }
                    },
                    "500": {
                        "description": "Database query error",
                        "schema": {
                            "$ref": "#/definitions/models.HTTPError"
                        }
                    }
                }
            }
        },
        "/data/collection/indicators_by_reference_data/{aggregation_level}/{lang}": {
            "get": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Retrieves the metadata of all indicators (e.g., name, unit, description, labels) for a specific aggregation level, translated to the specified language.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Indicators"
                ],
                "summary": "Get indicators metadata by reference",
                "parameters": [
                    {
                        "enum": [
                            "building"
                        ],
                        "type": "string",
                        "description": "Aggregation level",
                        "name": "aggregation_level",
                        "in": "path",
                        "required": true
                    },
                    {
                        "enum": [
                            "en",
                            "es",
                            "ca"
                        ],
                        "type": "string",
                        "description": "Language",
                        "name": "lang",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "List of indicators with multilingual fields translated",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    },
                    "400": {
                        "description": "Invalid or missing parameters",
                        "schema": {
                            "$ref": "#/definitions/models.HTTPError"
                        }
                    },
                    "500": {
                        "description": "Database query error",
                        "schema": {
                            "$ref": "#/definitions/models.HTTPError"
                        }
                    }
                }
            }
        },
        "/data/collection/vulnerability_index": {
            "post": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Returns a normalized vulnerability index (0–100) per reference code, using the provided weights for each indicator category.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Vulnerability"
                ],
                "summary": "Compute vulnerability index",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Calculation date (format: YYYY-MM-DD)",
                        "name": "calculation_date",
                        "in": "query",
                        "required": true
                    },
                    {
                        "description": "Weights for each KPI category",
                        "name": "weights",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/data.Weights"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Normalized vulnerability index per reference code",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "integer"
                            }
                        }
                    },
                    "400": {
                        "description": "Invalid input",
                        "schema": {
                            "$ref": "#/definitions/models.Message"
                        }
                    },
                    "404": {
                        "description": "No data found for the given date",
                        "schema": {
                            "$ref": "#/definitions/models.Message"
                        }
                    },
                    "500": {
                        "description": "Internal server error",
                        "schema": {
                            "$ref": "#/definitions/models.Message"
                        }
                    }
                }
            }
        },
        "/data/collection/{collection_name}": {
            "get": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Returns documents from the specified MongoDB collection. If the collection name does not end with \"_data\", the \"calculation_date\" query parameter is required.",
                "tags": [
                    "Indicators"
                ],
                "summary": "Get documents from collection",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Name of the MongoDB collection",
                        "name": "collection_name",
                        "in": "path",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "Calculation date (required unless collection ends with '_data')",
                        "name": "calculation_date",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "List of documents from the collection",
                        "schema": {
                            "type": "array",
                            "items": {
                                "type": "object"
                            }
                        }
                    },
                    "400": {
                        "description": "Missing or invalid parameters",
                        "schema": {
                            "$ref": "#/definitions/models.Message"
                        }
                    },
                    "405": {
                        "description": "Invalid HTTP method",
                        "schema": {
                            "$ref": "#/definitions/models.Message"
                        }
                    },
                    "500": {
                        "description": "Internal server error",
                        "schema": {
                            "$ref": "#/definitions/models.Message"
                        }
                    }
                }
            }
        },
        "/data/geometry_collection/{collection_name}": {
            "get": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Returns a GeoJSON collection where each feature includes the KPI values from the given collection. If the collection name ends with `_data`, it returns all data. Otherwise, it filters by `calculation_date`.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/geo+json"
                ],
                "tags": [
                    "Indicators"
                ],
                "summary": "Get a GeoJSON file with KPIs merged from the specified MongoDB collection",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Name of the MongoDB collection",
                        "name": "collection_name",
                        "in": "path",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "Calculation date to filter the KPIs (required if collection name does not end with '_data')",
                        "name": "calculation_date",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/data.GeoJSON"
                        }
                    },
                    "400": {
                        "description": "No data found for the given date",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "500": {
                        "description": "Internal server error while generating GeoJSON",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/data/geometry_collection_vulnerability_index": {
            "post": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Calculates and returns a GeoJSON file containing a normalized vulnerability index per reference, based on weighted KPIs and a given calculation date.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/geo+json"
                ],
                "tags": [
                    "Vulnerability"
                ],
                "summary": "Get GeoJSON with vulnerability index",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Calculation date in YYYY-MM-DD format",
                        "name": "calculation_date",
                        "in": "query",
                        "required": true
                    },
                    {
                        "description": "Weights for each KPI category",
                        "name": "weights",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/data.Weights"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "file"
                        }
                    },
                    "400": {
                        "description": "Invalid request payload or missing query parameter",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "404": {
                        "description": "No data found for the given date",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "500": {
                        "description": "Internal server error while generating GeoJSON",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/data/indoor_sensor_data/{property}/building/{aggregation_time}/{start}:{end}": {
            "get": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Returns indoor sensor indicators for a property within a time range.\n### Usage\n- **Admin:** can select aggregation level\n- **Registered users:** fixed to building level",
                "tags": [
                    "Indicators"
                ],
                "summary": "Get indoor sensor indicators",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Property name (temperature, humidity, co2)",
                        "name": "property",
                        "in": "path",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "Temporal aggregation (e.g., PT15M, PT1H, P1D)",
                        "name": "aggregation_time",
                        "in": "path",
                        "required": true
                    },
                    {
                        "type": "integer",
                        "description": "Start timestamp (Unix timestamp)",
                        "name": "start",
                        "in": "path",
                        "required": true
                    },
                    {
                        "type": "integer",
                        "description": "End timestamp (Unix timestamp)",
                        "name": "end",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Aggregated indoor indicators",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/models.IndoorStats"
                            }
                        }
                    },
                    "400": {
                        "description": "Missing or invalid parameters",
                        "schema": {
                            "$ref": "#/definitions/models.Message"
                        }
                    },
                    "405": {
                        "description": "Invalid HTTP method",
                        "schema": {
                            "$ref": "#/definitions/models.Message"
                        }
                    },
                    "500": {
                        "description": "Internal server error",
                        "schema": {
                            "$ref": "#/definitions/models.Message"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "data.CRS": {
